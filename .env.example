# ============================================================================
# DQ Investigator — Environment Variables
# ============================================================================
# Copy this file to .env for local development (never commit .env).
# On ECS, set these in the task definition's environment section or via
# AWS Secrets Manager.
# ============================================================================

# ── Authentication ───────────────────────────────────────────────────────────
# Comma-separated list of username:password pairs.
# Passwords are hashed at startup — plain text is never stored.
# Required when DQ_ENV=production. Falls back to dev defaults if unset locally.
DQ_USERS=admin:yourpassword,analyst:analystpass,demo:demopass

# Set to 'production' on ECS to enforce DQ_USERS and reject missing config.
DQ_ENV=production

# ── AI Providers ─────────────────────────────────────────────────────────────
# Anthropic Claude API key (used for AI enrichment and chat agent)
ANTHROPIC_API_KEY=sk-ant-...

# ── AWS ──────────────────────────────────────────────────────────────────────
# Only needed for local dev — on ECS the task IAM role handles auth.
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
#
# S3 write-back (Cleaning tab — persist analyst-approved cleaned datasets).
# A timestamped filename is appended to the prefix automatically.
# S3_WRITEBACK_BUCKET=my-data-quality-bucket
# S3_WRITEBACK_PREFIX=cleaned/

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (on ECS this is set by the task definition).
# Leave unset locally to use SQLite fallback.
# DATABASE_URL=postgresql://user:pass@host:5432/dqdb
